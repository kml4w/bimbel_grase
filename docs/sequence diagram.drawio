        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam backgroundColor #FFFFFF\nskinparam sequence {\n    ParticipantBackgroundColor #F4FBFA\n    ParticipantBorderColor #006A6A\n    ParticipantFontColor #006A6A\n    ActorBackgroundColor #006A6A\n    ActorBorderColor #006A6A\n    LifeLineBorderColor #006A6A\n    ArrowColor #006A6A\n}\n\nactor \&quot;Orang Tua\&quot; as Ortu\nparticipant \&quot;Client SPA\&quot; as SPA\nparticipant \&quot;Admin Console\&quot; as Admin\ndatabase \&quot;System State\&quot; as State\nparticipant \&quot;Paywall Guard\&quot; as Guard\n\nautonumber\n\nOrtu -&gt; SPA: Upload Bukti Bayar\nactivate SPA\n\nSPA -&gt; Admin: Submit Proof (Nota Transfer)\nactivate Admin\n\nAdmin -&gt; State: Update status paymentStatus to &#39;pending&#39;\nactivate State\nState --&gt; Admin: Status Updated\ndeactivate State\n\nAdmin -&gt; Admin: Tinjau Bukti &amp; Generate Canvas Receipt Image\n\nAdmin -&gt; State: Klik Approve (Verifikasi Lunas)\nactivate State\nState -&gt; State: Set paymentStatus = &#39;verified&#39;\nState --&gt; Admin: Verification Confirmed\ndeactivate State\n\nState -&gt; Guard: Unlock Access to LMS &amp; Modul\nactivate Guard\nGuard --&gt; State: Access Unlocked\ndeactivate Guard\n\nState --&gt; Ortu: Akses E-Learning LMS Terbuka\ndeactivate Admin\ndeactivate SPA\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="fOXNYJHMaN1s0uJzMiRD-81">
