        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam backgroundColor #FFFFFF\n\nclass OrangTua {\n  - parentEmail: String {PK}\n  - parentName: String\n  - parentPhone: String\n  - passwordHash: String\n  --\n  + registerAccount(): Boolean\n  + login(): Boolean\n  + addChildrenCard(): Void\n  + switchActiveChild(index): Void\n}\n\nclass Program {\n  - id: Integer {PK}\n  - name: String\n  - targetAge: String\n  - tutor: String\n  - schedule: String\n  - fee: Double\n  - desc: String\n  --\n  + getProgramInfo(): String\n  + updateFee(newFee): Void\n}\n\nclass Siswa {\n  - id: Integer {PK}\n  - parentEmail: String {FK}\n  - studentName: String\n  - age: String\n  - programName: String {FK}\n  - paymentStatus: Enum\n  - billingPeriod: String\n  - billingCount: Integer\n  - avatarUrl: String\n  --\n  + updateAvatar(newAvatarData): Void\n  + setPaymentStatus(status): Void\n  + calculateTotalFee(): Double\n  + isPaywallUnlocked(): Boolean\n}\n\nclass Pembayaran {\n  - id: Integer {PK}\n  - studentId: Int {FK}\n  - billingPeriod: String\n  - amount: Double\n  - paymentMethod: String\n  - proofFile: String\n  - status: Enum\n  --\n  + uploadProof(): Void\n  + verify(): Void\n}\n\nclass Submisi {\n  - id: Integer {PK}\n  - assignmentId: Integer {FK}\n  - studentId: Integer {FK}\n  - submittedFile: String\n  - submittedAt: String\n  - status: Enum\n  - score: Integer\n  - notes: String\n  --\n  + submitAssignment(): Void\n  + gradeSubmission(score): Void\n}\n\nclass Nilai {\n  - id: Integer {PK}\n  - studentId: Int {FK}\n  - taskName: String\n  - score: Integer\n  - gradeLetter: String\n  - notes: String\n  --\n  + calculateLetter(): String\n}\n\nclass Modul {\n  - id: Integer {PK}\n  - programName: String {FK}\n  - title: String\n  - pdfFileName: String\n  - desc: String\n  - uploadDate: String\n  --\n  + downloadPDF(): File\n}\n\nclass Tugas {\n  - id: Integer {PK}\n  - programName: String {FK}\n  - title: String\n  - pdfTitle: String\n  - openedDate: String\n  - dueDate: String\n  - highlightText: String\n  - instructions: Array\n  --\n  + publishTask(): Void\n}\n\nclass Kuis {\n  - id: Integer {PK}\n  - programName: String {FK}\n  - title: String\n  - questionsCount: Int\n  - duration: String\n  - questionsJSON: Text\n  --\n  + calculateScore(): Integer\n}\n\n&#39; Relasi dan Kardinalitas\nOrangTua \&quot;1\&quot; -- \&quot;1..*\&quot; Siswa : Mengelola &gt;\nProgram \&quot;1\&quot; -- \&quot;0..*\&quot; Siswa : Diikuti &gt;\nSiswa \&quot;1\&quot; *-- \&quot;0..*\&quot; Pembayaran : Memiliki &gt;\nSiswa \&quot;1\&quot; -- \&quot;0..*\&quot; Submisi : Mengirim &gt;\nSiswa \&quot;1\&quot; *-- \&quot;0..*\&quot; Nilai : Menerima &gt;\nTugas \&quot;1\&quot; -- \&quot;0..*\&quot; Submisi : Diserahkan untuk &gt;\n\nProgram \&quot;1\&quot; o-- \&quot;0..*\&quot; Modul\nProgram \&quot;1\&quot; o-- \&quot;0..*\&quot; Tugas\nProgram \&quot;1\&quot; o-- \&quot;0..*\&quot; Kuis\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_hfaARw-lk52f5fZqZVc-1">
